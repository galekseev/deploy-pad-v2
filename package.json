{
  "name": "deploy-pad-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "The deploy-pad v2 engine monorepo: the config contract and the engine that runs it.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "pnpm -r run build",
    "clean": "pnpm -r run clean",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:versions": "node scripts/check-versions.ts",
    "check:traceability": "node scripts/check-traceability.ts",
    "check:packed": "node scripts/smoke-packed.ts",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run check:versions && pnpm run check:traceability",
    "deploy-pad": "node packages/engine/src/main.ts"
  },
  "devDependencies": {
    "@deploy-pad/schemas": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
